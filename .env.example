# Copiar a .env y ajustar.

# Puerto publico de la API
API_PORT=8080

# Cuantas respuestas devuelve por busqueda si no se pide otra cosa
DEFAULT_LIMIT=20

# Tope duro, aunque el cliente pida mas
MAX_LIMIT=50

# Segundos que se guarda una busqueda en cache
CACHE_TTL=3600

# Si lo dejas vacio, la API es abierta.
# Si pones una clave, hay que mandarla en ?key= o en el header X-API-Key.
API_KEY=

# Segundos maximos esperando a SearXNG
UPSTREAM_TIMEOUT=25

# Clave interna de SearXNG (generala con: openssl rand -hex 32)
SEARXNG_SECRET=cambiar_esto_por_una_clave_larga
